{
  "manifest_version": 3,
  "name": "PA Bud",
  "version": "0.4.0",
  "description": "Shows why each failed flow run failed, directly in the run history list. Group, filter, export, and bulk-resubmit failures.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://make.powerautomate.com/*",
        "https://make.preview.powerautomate.com/*",
        "https://flow.microsoft.com/*",
        "https://*.flow.microsoft.com/*"
      ],
      "js": ["main.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
